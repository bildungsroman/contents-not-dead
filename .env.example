# ---------------------------------------------------------------------------
# Content's Not Dead — environment variables
# Copy to `.env.local` for local development. In production these are managed
# by your host (e.g. Vercel) and/or the Stripe Projects CLI.
# ---------------------------------------------------------------------------

# App URL (used for redirects, absolute links, MPP discovery). No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Stripe -----------------------------------------------------------------
# Restricted or secret key. Needs Products, Prices, Checkout Sessions,
# Customers, Billing Portal, PaymentIntents, and Webhooks write access.
STRIPE_SECRET_KEY=rk_test_...
# Optional publishable key — only required if you enable the in-browser
# (Stripe Elements) per-content payment page.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Subscription price IDs (created by `npm run setup:stripe`).
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_ANNUAL=price_...
# Webhook signing secret (from `stripe listen` or the Dashboard).
STRIPE_WEBHOOK_SECRET=whsec_...

# --- MPP (Machine Payments Protocol) ---------------------------------------
# A single, persistent >=32-byte secret used to HMAC-bind payment challenges.
# Must be stable across deploys/instances. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MPP_SECRET_KEY=
# Secret used to sign short-lived protected-asset (image) URLs.
CONTENT_ASSET_SECRET=

# --- Clerk (auth) -----------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# --- Demo mode --------------------------------------------------------------
# Enables the maximalist theme, theme switcher, and on-demand content
# generation. Should only be "true" on the official demo deployment.
NEXT_PUBLIC_IS_DEMO=false
# The canonical demo host. Content generation is only served when the request
# host matches this (or in local development).
DEMO_HOST=contentsnotdead.com

# --- Content generation (demo only) ----------------------------------------
# Provided by the private `content-generator` package + OpenRouter.
OPENROUTER_API_KEY=
# Comma-separated allowlists of OpenRouter model ids.
CONTENT_GENERATOR_TEXT_MODELS=openai/gpt-4o-mini
CONTENT_GENERATOR_IMAGE_MODELS=openai/gpt-image-1

# --- Upstash Redis (demo generation rate limiting) --------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
