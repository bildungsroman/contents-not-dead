# ---------------------------------------------------------------------------
# Content's Not Dead — environment variables
# Copy to `.env.local` for local development. In production these are managed
# by your host (e.g. Vercel) and/or the Stripe Projects CLI.
# ---------------------------------------------------------------------------

# App URL (used for redirects, absolute links, MPP discovery). No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Stripe -----------------------------------------------------------------
# Restricted or secret key. Needs Products, Prices, Checkout Sessions,
# Customers, Billing Portal, PaymentIntents, and Webhooks write access.
STRIPE_SECRET_KEY=rk_test_...
# Optional publishable key — only required if you enable the in-browser
# (Stripe Elements) per-content payment page.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Subscription price IDs (created by `npm run setup:stripe`).
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_ANNUAL=price_...
# Webhook signing secret (from `stripe listen` or the Dashboard).
STRIPE_WEBHOOK_SECRET=whsec_...

# --- MPP (Machine Payments Protocol) ---------------------------------------
# A single, persistent >=32-byte secret used to HMAC-bind payment challenges.
# Must be stable across deploys/instances. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MPP_SECRET_KEY=
# Secret used to sign short-lived protected-asset (image) URLs.
CONTENT_ASSET_SECRET=

# --- Clerk (auth) -----------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# --- Upstash Redis (optional) -----------------------------------------------
# Used for distributed rate limiting. Falls back to an in-memory counter when
# unset, so it's safe to leave blank for local/single-instance deploys.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
